{
  "name": "ruckus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @ruckus/server dev",
    "dev:client": "pnpm --filter @ruckus/client dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "check": "python3 tools/context_budget.py --check && python3 tools/kit_check.py --check && python3 tools/spec_status.py --check && python3 tools/status_html.py --check",
    "playtest": "bash tools/playtest.sh",
    "status": "python3 tools/spec_status.py && python3 tools/status_html.py",
    "bots": "node tools/bots.mjs",
    "playtest:solo": "bash tools/playtest.sh --bots 3"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
